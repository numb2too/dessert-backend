# Flask 配置
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# 資料庫配置
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=bakery_dev
MYSQL_USER=bakery_user
MYSQL_PASSWORD=bakery_pass
DATABASE_URL=mysql+pymysql://bakery_user:bakery_pass@localhost:3306/bakery_dev

# 測試資料庫
TEST_DATABASE_URL=mysql+pymysql://bakery_user:bakery_pass@localhost:3306/bakery_test

# Redis 配置（可選）
REDIS_URL=redis://localhost:6379/0

# API 配置
API_RATE_LIMIT=100